# ─────────────────────────────────────────────────────────────
# PCN Advogadas API — environment template.
# Copy to `.env` and fill with REAL values. `.env` is git-ignored.
# ─────────────────────────────────────────────────────────────

PROJECT_NAME="PCN Advogadas"
# development | test | staging | production
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Database (WebTuga MySQL/MariaDB or local docker). utf8mb4 is mandatory.
DATABASE_URL=mysql+asyncmy://pcn_user:CHANGE_ME@localhost:3306/pcn?charset=utf8mb4

# JWT signing key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_64_CHAR_RANDOM_HEX_STRING_CHANGE_ME_CHANGE_ME_00
# Fernet key used to encrypt TOTP secrets at rest —
# generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed frontend origins (no wildcards).
BACKEND_CORS_ORIGINS=http://localhost:3000
# Must be true in production (HTTPS only cookies).
COOKIE_SECURE=false

# Fee notes (confirm rates with the firm's accountant).
DEFAULT_VAT_RATE=0.23
DEFAULT_WITHHOLDING_RATE=0.23
FEE_NOTE_PREFIX=NH
# Absolute path to the PNG logo used in exported fee notes (optional).
LOGO_PATH=
